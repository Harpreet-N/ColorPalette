# Rules without a leading slash match at ANY depth, so they keep working
# wherever the app folder is moved (currently /Code). Rules with a leading
# slash are deliberately pinned to the repo root.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output / caches
.next/
.vinext/
.vercel
dist/
out/
coverage/
tsconfig.tsbuildinfo
next-env.d.ts
.wrangler/

# local environment
.env*
!.env.example
*.pem

# editor / OS
.idea/
.DS_Store

# agent tooling (plugin caches, not project code)
.agents/
skills-lock.json

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# workbench/ is not part of the project: marketing renders, screenshots,
# notes and archived experiments. It sits beside the code for convenience
# only, is never imported, never deployed, and is not version controlled.
/workbench/
