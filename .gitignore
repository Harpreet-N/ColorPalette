# Rules without a leading slash match at ANY depth, so they keep working
# wherever the app folder is moved (currently /Code). Rules with a leading
# slash are deliberately pinned to the repo root.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output / caches
.next/
.vinext/
.vercel
dist/
out/
coverage/
tsconfig.tsbuildinfo
next-env.d.ts
.wrangler/

# local environment
.env*
*.pem

# editor / OS
.idea/
.DS_Store

# agent tooling (plugin caches, not project code)
.agents/
skills-lock.json

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# workbench: marketing, notes, archived experiments.
# Tracked: all of marketing/ (the carousels are a deliverable and are NOT
# currently reproducible -- see workbench/marketing/README.md) and notes/.
# Ignored: plugin output, verification screenshots, dead code.
/workbench/brag/
/workbench/screenshots/
/workbench/archive/
